# Copia este archivo a infra/.env SOLO si necesitas cambiar algun valor.
# Sin infra/.env, compose usa estos mismos valores por defecto.
# Son credenciales de desarrollo local: nunca las uses en produccion.

POSTGRES_USER=porteria
POSTGRES_PASSWORD=porteria
POSTGRES_DB=porteria

# Puerto en tu maquina (dentro del contenedor siempre es 5432).
# Usa 5433 si ya tienes PostgreSQL instalado en Windows.
POSTGRES_PORT=5432

# Puerto de Adminer (solo arranca con --profile tools).
ADMINER_PORT=8080

# Para la API (fase 0, paso 4). Desde tu maquina el host es 127.0.0.1 (no localhost:
# el puerto solo escucha en IPv4); desde otro contenedor de compose seria "postgres".
# Si cambias POSTGRES_PORT, cambia tambien el puerto de esta URL.
# DATABASE_URL=postgresql+psycopg://porteria:porteria@127.0.0.1:5432/porteria
